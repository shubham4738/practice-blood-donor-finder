rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /donors/{donorId} {
      // Anyone can query and read donors so urgent patients and blood banks can find them
      allow read: if true;

      // Only authenticated users can register a profile, and userId must match request.auth.uid
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && request.resource.data.isAvailable is bool;

      // Only the profile owner can update their profile (including the availability toggle)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Only the profile owner can delete their profile
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
